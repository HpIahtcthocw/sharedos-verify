# ============================================================
# sharedos-verify · A2A 验真服务
# ============================================================

# ---- 模型 Provider（默认 qwen，可选 claude）----
PROVIDER=qwen

# ---- Qwen / DashScope（推荐 — 有免费额度）----
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# ---- Anthropic Claude（可选）----
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ---- 覆盖默认模型名（按 provider 选一个）----
# MASK_MODEL=qwen-plus          # Qwen 默认
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---- 服务端口 ----
PORT=4000
