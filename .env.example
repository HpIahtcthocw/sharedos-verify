# ============================================================
# sharedos-verify · A2A 验真服务
# ============================================================

# ---- 模型 Provider（默认 deepseek，可选 qwen）----
PROVIDER=deepseek

# ---- DeepSeek / SiliconFlow（推荐 — 国内平台，免费额度充足）----
# 注册: https://siliconflow.cn
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# ---- 覆盖默认模型名 ----
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V2.5

# ---- Qwen / DashScope（备用 — 阿里云，免费额度可能用完）----
# PROVIDER=qwen
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
# MASK_MODEL=qwen-plus

# ---- 服务端口 ----
PORT=4000

# ---- SharedNet 房间监听 (比赛在场必备) ----
# 优先用 MEMBER_TOKEN+SEAT_ID 复用已加入的 seat (重启不换身份);
# 只有 ROOM_ID+TOKEN 时会每次 join 出一个新 seat
# SHAREDNET_ROOM_ID=rom_xxxxxxxx
# SHAREDNET_MEMBER_TOKEN=sni_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SHAREDNET_SEAT_ID=i_xxxxxxxx
# SHAREDNET_TOKEN=rit_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # 仅首次 join 用
# 注意: DashScope qwen-plus 免费额度耗尽时用 MASK_MODEL=qwen-plus-latest

# ---- SharedOS Cloud 决策事件上报 (design-partner preview, 开发期免费) ----
# 在 sharedos.ai 登录创建 Cloud 项目并完成 onboarding 后, 填事件上报端点:
# SHAREDOS_CLOUD_EVENTS_URL=https://...
# SHAREDOS_CLOUD_EVENTS_TOKEN=

# ---- 审计 (可选) ----
# AUDIT_DIR=./audit
# DISCORD_AUDIT_WEBHOOK=
